# evals
eval "$(atuin init --disable-ctrl-r zsh)"

# Use different history when in normal mode
bindkey -M vicmd '^[[A' up-line-or-history
bindkey -M vicmd '^[OA' up-line-or-history

# ALT-C: cd into the selected directory
# CTRL-T: Place the selected file path in the command line
# CTRL-R: Place the selected command from history in the command line
# CTRL-P: Place the selected process ID in the command line
eval $(thefuck --alias)
eval "$(zoxide init zsh)"
if command -v pyenv >/dev/null 2>&1; then
    eval "$(pyenv init -)"
fi

# TheFuck
eval $(thefuck --alias)

# Auto notify
AUTO_NOTIFY_IGNORE+=("yy" "yazi" "nvim" "btop" "kitten" "lazyconfig" "lazygit" "dua" "ncdu" "cbonsai" "batman" "dragon-drop")
export AUTO_NOTIFY_THRESHOLD=5
source /usr/share/zsh/plugins/zsh-auto-notify/auto-notify.plugin.zsh

# Plugins
#source /usr/share/autojump/autojump.zsh
source /usr/share/fzf/completion.zsh
#source /usr/share/zsh/plugins/forgit/forgit.plugin.zsh
#source /usr/share/zsh/site-functions/_git-forgit
source ~/.config/zsh/plugins/fzf-zsh-plugin/fzf-zsh-plugin.zsh
source /usr/share/zsh/plugins/fzf-tab-git/fzf-tab.zsh

zvm_config() {
    #ZSH_VI_MODE_CURSOR=false
    ZVM_INSERT_MODE_CURSOR="$ZVM_CURSOR_BLINKING_BEAM"
    ZVM_NORMAL_MODE_CURSOR="$ZVM_CURSOR_BLINKING_BLOCK"
    ZVM_OPPEND_MODE_CURSOR="$ZVM_CURSOR_BLINKING_UNDERLINE"
}
source /usr/share/zsh/plugins/zsh-vi-mode/zsh-vi-mode.plugin.zsh

# Load zsh-syntax-highlighting; should be last.
source ~/.config/zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh
source ~/.config/zsh/plugins/jq-zsh-plugin/jq.plugin.zsh
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.plugin.zsh

#source /usr/share/zsh/plugins/zsh-autocomplete/zsh-autocomplete.plugin.zsh
